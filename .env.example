# ─────────────────────────────────────────────────────────────────────────────
# Required (every setup)
# ─────────────────────────────────────────────────────────────────────────────

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Public URL of this instance (used by auth cookies, CSRF, etc.)
ORIGIN="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Local development (pnpm dev, with `compose.dev.yaml` running Postgres + MinIO)
# These match the defaults in compose.dev.yaml.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL="postgres://postgres:postgres@localhost:5432/wrkin"

# MinIO (S3-compatible file storage)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="wrkin"
S3_FORCE_PATH_STYLE="true"

# ─────────────────────────────────────────────────────────────────────────────
# Docker all-in-one (docker compose / podman compose up)
#
# The compose stack builds DATABASE_URL and the S3 endpoint from the variables
# below — the DATABASE_URL / S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY above
# are NOT read by compose. All of these have sane defaults; only
# BETTER_AUTH_SECRET (above) is strictly required. Uncomment to override.
# ─────────────────────────────────────────────────────────────────────────────

# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=wrkin
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# S3_BUCKET=wrkin
# S3_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# Collaborative docs (optional)
# ─────────────────────────────────────────────────────────────────────────────

# PUBLIC_COLLAB_WS_URL=ws://localhost:1234
# COLLAB_JWT_SECRET=""  # defaults to BETTER_AUTH_SECRET
# HOCUSPOCUS_PORT=1234
