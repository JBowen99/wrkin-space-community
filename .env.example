# Drizzle / Postgres
DATABASE_URL="postgres://user:password@localhost:5432/wrkin"

# MinIO (S3-compatible file storage)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="wrkin"
S3_FORCE_PATH_STYLE="true"

# Public URL of this instance (used by auth cookies, CSRF, etc.)
ORIGIN="http://localhost:3000"

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Collaborative docs (optional)
# PUBLIC_COLLAB_WS_URL=ws://localhost:1234
# COLLAB_JWT_SECRET=""
# HOCUSPOCUS_PORT=1234
