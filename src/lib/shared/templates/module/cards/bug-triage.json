{
	"id": "bug-triage",
	"moduleType": "cards",
	"name": "Bug triage",
	"description": "New, investigating, and fixed — with severity, reporter, and dates.",
	"headline": "Prioritize bugs with severity and ownership.",
	"sortOrder": 50,
	"includesSampleContent": true,
	"schema": {
		"fields": [
			{ "key": "title", "label": "Title", "type": "short_text", "required": true },
			{
				"key": "severity",
				"label": "Severity",
				"type": "select",
				"required": true,
				"options": ["Critical", "High", "Medium", "Low"]
			},
			{ "key": "reporter", "label": "Reporter", "type": "short_text", "required": false },
			{ "key": "found_date", "label": "Bug found date", "type": "date", "required": false },
			{ "key": "fixed_date", "label": "Bug fixed date", "type": "date", "required": false },
			{ "key": "notes", "label": "Notes", "type": "long_text", "required": false }
		]
	},
	"layout": {
		"primaryFieldKey": "title",
		"faceFieldKeys": ["title", "severity"]
	},
	"columns": [
		{
			"title": "New",
			"color": "#ef4444",
			"position": 0,
			"cards": [
				{
					"position": 0,
